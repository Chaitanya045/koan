# Frame dumps, to check what the page looks like (scripts/e2e/run.sh).
--ozone-dump-file={dump}
# macOS (scripts/mac/suite.sh) has no frame dumps; the script checks the
# page's size there instead (see its header).
# macos: without frame dumps
# Glance's Split Glance limit path and each toast (VLOG 1), for the check
# "Split Glance over a split shows the limit toast" (koan-glance_split.log).
--vmodule=koan_glance_controller=1,koan_toast=1
