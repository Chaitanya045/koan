# Where the Mac bench is. Copy this file to scripts/mac/local.env (git-ignored)
# and fill it in, or export the same three variables in the environment.
# Nothing here has a default in the repo: scripts/mac/vtabs.sh and
# scripts/mac/drv/vtabs.mjs stop with a message if one is missing.
KOAN_MAC_HOST=<mac-host>      # the Mac's host name or IP address
KOAN_MAC_USER=<user>          # its user name (the Koan folder is /Users/<user>/work/koan-mac)
KOAN_MAC_KEY=<ssh-key>        # path of the ssh private key to log in with
