# The e2e scripts scripts/mac/suite.sh runs on the Mac, in order:
#   <name> [timeout=<seconds>]
# <name> is scripts/e2e/<name>.mjs (its .flags, prefs/<name>.json and
# local_state/<name>.json apply, as with run.sh). The default timeout is 300 s.
# `suite.sh --all-e2e` runs every scripts/e2e/*.mjs instead (to port more);
# scripts whose .flags need Linux's headless Ozone ({dump}, --ozone-*) are
# skipped there.
#
# Written for the Mac suite (Mac key codes, real input when allowed):
window_teardown timeout=420
window_sync timeout=420
# Spaces across quits and starts on one profile (no Space made per start).
spaces_relaunch timeout=300
# Containers per Space (#318): a Space keeps its own logins, across a start.
space_containers timeout=300
space_drag timeout=420
welcome_input timeout=240
lights_hover_steady timeout=120
agent_cli timeout=420
# Copy current URL with several tabs selected (palette, test_helper).
copy_urls timeout=180
# Existing scripts. lib/koan.mjs key() sends Mac key codes on macOS (and the
# scripts ACCEL, Cmd there), so these mean the same on the Mac. Scripts that
# need a main-menu key (Cmd+W, Cmd+Shift+W, Cmd+Q, Cmd+L, Cmd+Shift+T: CDP
# keys never reach the menu bar) or Linux-only bits end with a SKIP on macOS
# (skipOnMac()) until they're ported (#270).
background_tab_toast
colors
compact_close
compact_flash
compact_single
download_animation
fullscreen_compact
fullscreen_multiple
fullscreen_single
# Glance: Alt+click, Cmd+O, the trigger setting (Cmd+click on the Mac,
# prefs/glance_activation.mac.json), the card, split and Glance's menus.
glance
glance_activation
glance_split timeout=420
library
library_history
newtab
newtab_custom
omnibox_trailing_space
scrollbars
# The one Settings page: Koan's panes in chrome://settings, its search,
# deep links and the old chrome://koan-settings (#297).
settings timeout=420
# Each behaviour row's effect, Chromium's rows Koan overrides, two restarts
# (docs/SETTINGS_AUDIT.md).
settings_effects_behaviour timeout=900
# Each visual setting changed through the page, and its effect in the window
# (docs/SETTINGS_AUDIT.md).
settings_effects_visual timeout=600
shortcuts
sidebar_animation
sidebar_drag
# Zen's audio badge on an Essentials tile (favicon kept, click mutes).
essentials_audio
spaces_switching
tabs_right
urlbar
vertical_tabs_drag
vertical_tabs_hover
vertical_tabs_old_profile
vertical_tabs_teardown
window_drag
workspaces
