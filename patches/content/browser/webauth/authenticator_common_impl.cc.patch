 void AuthenticatorCommonImpl::Cancel() {
+  // Koan: a request the embedder holds is answered too.
+  if (WebContentsDelegate* delegate =
+          WebContents::FromRenderFrameHost(GetRenderFrameHost())
+              ->GetDelegate()) {
+    delegate->CancelHeldWebAuthnRequests(GetRenderFrameHost());
+  }
   CancelWithStatus(blink::mojom::AuthenticatorStatus::ABORT_ERROR);
