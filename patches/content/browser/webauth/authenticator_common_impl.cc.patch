+// Koan: what holds a request `render_frame_host` makes now
+// (WebContentsDelegate::HoldWebAuthnRequest()), or null.
+base::OnceCallback<void(WebContentsDelegate::WebAuthnRun)> HoldForEmbedder(
+    RenderFrameHost* render_frame_host) {
+  WebContentsDelegate* delegate =
+      WebContents::FromRenderFrameHost(render_frame_host)->GetDelegate();
