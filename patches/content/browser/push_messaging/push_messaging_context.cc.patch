+// Koan: whether `context` is a Koan container's (or no longer has a
+// partition). Its registration ids are its own, while the profile's push
+// subscriptions are keyed by origin and registration id and are the default
+// partition's (push is refused in containers), so its events must never
+// unsubscribe one (#596).
+bool IsKoanContainer(ServiceWorkerContextWrapper* context) {
+  StoragePartitionImpl* partition = context->storage_partition();
+  return !partition || koan::containers::IsContainerPartitionDomain(
+                           partition->GetConfig().partition_domain());
+}
