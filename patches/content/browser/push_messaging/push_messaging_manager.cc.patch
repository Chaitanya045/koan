 PushMessagingService* PushMessagingManager::GetService() {
+  // Koan: no push in a Space's profile: push messages go to the origin's
+  // default partition.
+  if (koan::containers::IsUserPartitionDomain(render_process_host_
+                                                  ->GetStoragePartition()
+                                                  ->GetConfig()
+                                                  .partition_domain())) {
+    return nullptr;
+  }
   return render_process_host_->GetBrowserContext()->GetPushMessagingService();
 }
 
