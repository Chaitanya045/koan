+RenderFrameHost*
+NotificationEventDispatcherImpl::GetNonPersistentNotificationFrame(
+    const std::string& notification_id) {
+  auto listener = non_persistent_notification_listeners_.find(notification_id);
+  return listener == non_persistent_notification_listeners_.end()
+             ? nullptr
+             : listener->second.document.AsRenderFrameHostIfValid();
+}
