@@ -504,6 +504,25 @@ class CONTENT_EXPORT WebContentsDelegate {
                               scoped_refptr<FileSelectListener> listener,
                               const blink::mojom::FileChooserParams& params);
 
+  // Koan: whether the file chooser `render_frame_host` asks for waits (an
+  // agent holds its tab). `show` then runs later, with true to run the chooser
+  // again, with false to cancel it.
+  virtual bool HoldFileChooser(RenderFrameHost* render_frame_host,
+                               base::OnceCallback<void(bool show)> show);
+
+  // Koan: what holds the WebAuthn request (a modal create() or get())
+  // `render_frame_host` makes now, if it waits (an agent holds its tab), or
+  // null. Content gives it the request's `run`, which runs once, later: with
+  // true to make the request again from the start (which runs or drops `done`
+  // when it ends), with false to answer it as the user's cancel.
+  using WebAuthnRun =
+      base::OnceCallback<void(bool run, base::OnceClosure done)>;
+  virtual base::OnceCallback<void(WebAuthnRun run)> HoldWebAuthnRequest(
+      RenderFrameHost* render_frame_host);
+  // Koan: the page of `render_frame_host` aborted its WebAuthn request: the
+  // ones held for it are answered as cancelled.
+  virtual void CancelHeldWebAuthnRequests(RenderFrameHost* render_frame_host);
+
 #if BUILDFLAG(IS_ANDROID)
   // Set to true if RunFileChooser() should be used for FileSystemAccess APIs.
   virtual bool UseFileChooserForFileSystemAccess() const;
