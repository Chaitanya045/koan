 bool HitTestCaptionButton(views::Button* button, const gfx::Point& point) {
+  // Koan: a button that ignores events (Koan hides the caption buttons
+  // until the pointer reaches the top edge) isn't hit either.
   return button && button->GetVisible() &&
+         button->GetCanProcessEventsWithinSubtree() &&
          button->GetMirroredBounds().Contains(point);
 }
 
