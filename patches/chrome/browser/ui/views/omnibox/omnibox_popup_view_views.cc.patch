diff --git a/chrome/browser/ui/views/omnibox/omnibox_popup_view_views.cc b/chrome/browser/ui/views/omnibox/omnibox_popup_view_views.cc
--- a/chrome/browser/ui/views/omnibox/omnibox_popup_view_views.cc
+++ b/chrome/browser/ui/views/omnibox/omnibox_popup_view_views.cc
@@ -35,6 +35,7 @@
 #include "components/omnibox/common/omnibox_feature_configs.h"
 #include "components/omnibox/common/omnibox_metrics_utils.h"
 #include "components/viz/common/frame_timing_details.h"
+#include "koan/browser/ui/views/koan_url_bar.h"
 #include "ui/accessibility/ax_node_data.h"
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/compositor/closure_animation_observer.h"
@@ -347,7 +348,13 @@
       // Drop stale metrics callbacks.
       metrics_weak_factory_.InvalidateWeakPtrs();
 
-      widget_->CloseAnimated();  // This will eventually delete the popup.
+      // Koan: no 82 ms fade-out (Zen's results close in a single frame). On
+      // macOS a popup opened while the previous one was still fading out was
+      // torn down with it, and `widget_` still pointed at it, so no
+      // suggestions showed again until the omnibox closed. Close() orders
+      // the window out now and deletes it in a posted task, ahead of
+      // whatever opens the next popup.
+      widget_->Close();  // This will eventually delete the popup.
       widget_->RemoveObserver(&widget_observer_helper_);
       widget_.reset();
 
@@ -757,6 +764,11 @@
 
   // Finally, expand the widget to accommodate the custom-drawn shadows.
   content_rect.Inset(-RoundedOmniboxResultsFrame::GetShadowInsets());
+  // Koan: in Zen's floating URL bar card, the suggestions under its input row.
+  koan::AdjustOmniboxPopupBounds(
+      location_bar_view_,
+      popup_height - RoundedOmniboxResultsFrame::GetNonResultSectionHeight(),
+      content_rect);
   return content_rect;
 }
 
