+// Koan: a Space that was one of an old profile's saved groups is disconnected
+// from it through the service's public RemoveLocalTabGroupMapping()
+// (KoanWorkspaceController::DisconnectSavedGroups()). DisconnectLocalTabGroup()
+// pairs that with dropping the group's listener, which a listener for a group
+// the service no longer maps needs before the next tab move, add or resume
+// (it CHECKs the saved group). So any such listener goes first.
+void DropKoanDisconnectedListeners(
+    std::unordered_map<TabGroupId, LocalTabGroupListener, TabGroupIdHash>&
+        listeners,
+    TabGroupSyncService* service,
+    Profile* profile) {
+  if (koan::SavesTabGroups(profile)) {
+    return;
+  }
+  std::erase_if(listeners, [service](const auto& entry) {
+    return !service->GetGroup(entry.first).has_value();
+  });
+}
+
+}  // namespace
