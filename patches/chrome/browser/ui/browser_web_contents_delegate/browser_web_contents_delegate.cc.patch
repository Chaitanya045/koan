+  // Koan Glance: an activation click (Alt+click by default) opens the link
+  // in a floating card; one Glance declines gets its modifier's usual
+  // disposition (koan/browser/ui/views/koan_glance.h).
+  WindowOpenDisposition koan_fallback = WindowOpenDisposition::kCurrentTab;
+  switch (koan::MaybeOpenGlance(&*browser_, source, params, &koan_fallback)) {
+    case koan::GlanceClick::kOpened:
+      return source;
+    case koan::GlanceClick::kDeclined: {
+      content::OpenURLParams fallback_params(params);
+      fallback_params.disposition = koan_fallback;
+      return OpenURLFromTab(source, fallback_params,
+                            std::move(navigation_handle_callback));
+    }
+    case koan::GlanceClick::kNone:
+      break;
+  }
