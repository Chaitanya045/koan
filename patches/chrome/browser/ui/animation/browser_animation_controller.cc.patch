diff --git a/chrome/browser/ui/animation/browser_animation_controller.cc b/chrome/browser/ui/animation/browser_animation_controller.cc
--- a/chrome/browser/ui/animation/browser_animation_controller.cc
+++ b/chrome/browser/ui/animation/browser_animation_controller.cc
@@ -486,6 +486,7 @@
   // Starts `motion` for the current group. Any existing motion will be
   // canceled.
   void Start(BrowserAnimationMotion motion, MotionInfo motion_info) {
+    ++start_count_;
     const auto params = GetParamsLookup();
     OnCancel(params);
     current_motion_ = motion;
@@ -504,11 +505,16 @@
 
   // Resets the animation for the current group to the end of `motion`.
   void Reset(BrowserAnimationMotion motion, MotionInfo motion_info) {
+    ++start_count_;
     const auto params = GetParamsLookup();
     if (current_motion_ != motion) {
       OnCancel(params);
       current_motion_ = motion;
       current_motion_info_ = std::move(motion_info);
+    } else if (animator_) {
+      // Koan: fast-forwarding the playing motion stops its animator, whose
+      // next step would otherwise find no motion (a CHECK).
+      animator_->Stop();
     }
     OnAnimationEnded(params);
   }
@@ -619,7 +625,16 @@
       logger_->MaybeLog();
       logger_.reset();
     }
+    const int start_count = start_count_;
     Notify(BrowserAnimationUpdate::kEnded);
+    // Koan: a listener of `kEnded` can start the next motion (the vertical tab
+    // strip's region view does, from the collapse's end, with a keep-expanded
+    // lock held). That motion is now current and its animator is running:
+    // clearing it here fails CHECK(current_motion_) at the next step. Starting
+    // it already persisted this motion's values.
+    if (start_count != start_count_) {
+      return;
+    }
     current_motion_ = BrowserAnimationMotion();
     PersistCurrentValues(params);
   }
@@ -706,6 +721,9 @@
   ValueLookup current_values_;
   BrowserAnimationMotion current_motion_;
   MotionInfo current_motion_info_;
+  // Koan: counts Start() and Reset(), to tell whether a listener started a
+  // motion during the kEnded notification (see OnAnimationEnded()).
+  int start_count_ = 0;
   std::optional<Animator> animator_;
   std::optional<Logger> logger_;
 
