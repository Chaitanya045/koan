@@ -53,6 +54,14 @@ NavigationPolicy NavigationPolicyFromEventModifiers(int16_t button,
                                                     bool shift,
                                                     bool alt,
                                                     bool meta) {
+  // Koan Glance: a left click with the Glance activation modifier alone
