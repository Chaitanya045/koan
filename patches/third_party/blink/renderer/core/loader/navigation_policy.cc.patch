+    // Koan Glance: no Glance (or popup) from synthesized activation clicks.
+    return kNavigationPolicyCurrentTab;
+  }
+
   return event_policy;
 }
 
@@ -182,9 +197,11 @@ NavigationPolicy NavigationPolicyForCreateWindow(
     return app_policy;
   }
 
