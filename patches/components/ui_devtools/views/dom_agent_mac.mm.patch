+++ b/components/ui_devtools/views/dom_agent_mac.mm
@@ -51,12 +51,20 @@ std::vector<UIElement*> DOMAgentMac::CreateChildrenForRoot() {
 
 void DOMAgentMac::OnWidgetDestroying(views::Widget* widget) {
   widget->RemoveObserver(this);
-  roots_.erase(std::ranges::find(roots_, widget), roots_.end());
+  // Koan: only this widget (upstream erased every root after it too, so a
+  // widget closed during a session hid the ones made after it: the toast
+  // that a closing Glance card shows).
+  std::erase(roots_, widget);
 }
 
 void DOMAgentMac::OnNativeWidgetAdded(views::NativeWidgetMac* native_widget) {
   views::Widget* widget = native_widget->GetWidget();
   DCHECK(widget);
+  // Koan: no document yet (enabled, not read): CreateChildrenForRoot() finds
+  // every open window, this one too, when it is read.
+  if (!element_root()) {
+    return;
+  }
   roots_.push_back(widget);
   UIElement* widget_element = new WidgetElement(widget, this, element_root());
   element_root()->AddChild(widget_element);
