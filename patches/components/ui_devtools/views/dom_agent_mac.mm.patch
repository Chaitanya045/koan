diff --git a/components/ui_devtools/views/dom_agent_mac.mm b/components/ui_devtools/views/dom_agent_mac.mm
index 32b3915a3e00b9b2bb151f8c1f74014caebb51d4..d81e42914deb08175284f8fd62436ffd20864e13 100644
