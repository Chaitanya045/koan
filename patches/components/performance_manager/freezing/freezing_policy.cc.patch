+void FreezingPolicy::OnMainFrameDocumentChanged(const PageNode* page_node) {
+  // A new document: the player that made the sound is gone.
+  auto& page_freezing_state = GetFreezingState(page_node);
+  page_freezing_state.played_audio_timer.Stop();
+  if (page_freezing_state.cannot_freeze_reasons.Has(
+          CannotFreezeReason::kPlayedAudio) &&
+      !page_node->IsAudible()) {
+    OnCannotFreezeReasonChange(page_node, /*add=*/false,
+                               CannotFreezeReason::kPlayedAudio);
   }
