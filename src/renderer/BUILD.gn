# Koan's code in renderer processes, started from
# ChromeContentRendererClient::RenderThreadStarted() (chrome/renderer).
source_set("renderer") {
  sources = [
    "koan_render_thread_observer.cc",
    "koan_render_thread_observer.h",
  ]
  deps = [
    "//base",
    "//content/public/renderer",
    "//koan/common:glance_trigger",
    "//koan/common:renderer_settings_mojom",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
  ]
}
