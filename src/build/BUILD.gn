import("//build/config/compiler/compiler.gni")
import("//koan/build/thin_lto.gni")

# Caps the ThinLTO backend threads of every link that has Koan's code in it
# (above all the Chromium framework), without a patch: upstream passes
# -Wl,--thinlto-jobs=all in //build/config/compiler:compiler, the flags of a
# dependency's all_dependent_configs come after a target's own configs, and
# lld takes the last --thinlto-jobs. Applied through
# //koan/browser:feature_overrides, which //chrome/browser depends on.
# scripts/mac/build_official.sh checks the framework's link line after gn gen
# and stops if the cap isn't the last value there.
config("thin_lto_jobs") {
  if (use_thin_lto && koan_thin_lto_jobs > 0) {
    ldflags = [ "-Wl,--thinlto-jobs=$koan_thin_lto_jobs" ]
  }
}
