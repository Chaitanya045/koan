import("//build/config/ui.gni")
import("//testing/test.gni")

# Koan's unit tests: pure logic that links without the browser (//base and the
# small Koan source sets, no //chrome/browser), for areas without a test
# target of their own. See "Which test to write" in CONTRIBUTING.md.
test("koan_unittests") {
  sources = [
    "//koan/browser/importer/koan_chromium_profile_reader_unittest.cc",
    "//koan/browser/importer/koan_import_sources_unittest.cc",
    "//koan/browser/koan_copy_urls_unittest.cc",
    "//koan/browser/koan_fuzzy_score_unittest.cc",
    "//koan/browser/koan_library_logic_unittest.cc",
    "//koan/browser/koan_prefs_unittest.cc",
    "//koan/browser/koan_space_title_unittest.cc",
    "//koan/browser/ui/webui/koan_settings_url_unittest.cc",
    "//koan/browser/updates/koan_update_logic_unittest.cc",
    "//koan/browser/window_sync/koan_window_sync_model_unittest.cc",
    "//koan/common/koan_glance_trigger_unittest.cc",
  ]
  deps = [
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/performance_manager",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//crypto",
    "//koan/browser:copy_urls",
    "//koan/browser:features",
    "//koan/browser:fuzzy_score",
    "//koan/browser:library_logic",
    "//koan/browser:prefs",
    "//koan/browser:space_title",
    "//koan/browser/importer:reader",
    "//koan/browser/importer:sources",
    "//koan/browser/ui/webui:settings_url",
    "//koan/browser/updates:update_logic",
    "//koan/browser/window_sync:model",
    "//koan/common:glance_trigger",
    "//sql",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
  data_deps = [ "//third_party/icu:icudata" ]
}

# Koan's browser tests (InProcessBrowserTest): Spaces, pinned tabs and what
# Koan keeps in the session, against a real browser window. They need a
# display (Xvfb, or --ozone-platform=headless) and run on request, with
# scripts/test_browser.sh; see "Which test to write" in CONTRIBUTING.md.
source_set("browsertests_impl") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "browser/koan_browser_test_utils.cc",
    "browser/koan_browser_test_utils.h",
    "browser/koan_essentials_drop_browsertest.cc",
    "browser/koan_glance_settings_browsertest.cc",
    "browser/koan_import_browsertest.cc",
    "browser/koan_playing_page_adoption_browsertest.cc",
    "browser/koan_session_data_browsertest.cc",
    "browser/koan_session_restore_browsertest.cc",
    "browser/koan_sidebar_transitions_browsertest.cc",
    "browser/koan_space_containers_browsertest.cc",
    "browser/koan_spaces_browsertest.cc",
    "browser/koan_split_view_browsertest.cc",
    "browser/koan_tab_management_browsertest.cc",
    "browser/koan_toolbar_browsertest.cc",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/bookmarks",
    "//chrome/browser/importer",
    "//chrome/browser/metrics",
    "//chrome/browser/password_manager/factories",
    "//chrome/browser/prefs",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sessions:test_support",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/frame:browser_widget",
    "//chrome/browser/ui/views/frame:vertical_tab_strip_region_view",
    "//chrome/browser/ui/views/tabs/common",
    "//chrome/browser/ui/views/tabs/common:impl",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_tests_runner",
    "//components/bookmarks/browser",
    "//components/bookmarks/test",
    "//components/keyed_service/core",
    "//components/password_manager/core/browser/password_store:password_store_interface",
    "//components/password_manager/core/browser/password_store:test_support",
    "//components/prefs",
    "//components/signin/public/base",
    "//components/split_tabs",
    "//components/tab_groups",
    "//components/tabs:public",
    "//components/user_data_importer/common",
    "//content/public/browser",
    "//content/public/common",
    "//content/test:test_support",
    "//ipc",
    "//koan/browser:features",
    "//koan/browser:prefs",
    "//koan/browser/containers:partition",
    "//koan/browser/containers:user_containers",
    "//koan/browser/importer",
    "//koan/browser/ui/views:impl",
    "//koan/common:renderer_settings_mojom",
    "//mojo/public/cpp/bindings",
    "//net",
    "//net:test_support",
    "//services/network/public/mojom",
    "//sql",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//ui/actions",
    "//ui/base",
    "//ui/base:types",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/views",
    "//ui/views:test_support",
    "//url",
