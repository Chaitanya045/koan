import("//testing/test.gni")

# Containers: a StoragePartition of their own inside the user's profile
# (.agent/notes/agent-control.md section 7). Agent containers, and user
# containers per Space (#111).

# The partition domains, with no dependency at all, for the hooks in
# //content/browser (which :partition depends on).
source_set("domain") {
  sources = [ "koan_partition_domain.h" ]
}

# "What agents can use": the switches' prefs (koan_agent_access_prefs.h).
# //components/prefs only, for //koan/browser:prefs, which registers them.
source_set("access_prefs") {
  sources = [
    "koan_agent_access_prefs.cc",
    "koan_agent_access_prefs.h",
  ]
  deps = [ "//components/prefs" ]
}

# What a container is, the SiteInstances upstream's hooks put new tabs in, and
# the blocks' check of the user's switches (koan_agent_access.h). Depends on
# //base, //components/prefs, //components/user_prefs and
# //content/public/browser only, so upstream targets in components/ and
# extensions/ can depend on it.
source_set("partition") {
  sources = [
    "koan_agent_access.cc",
    "koan_agent_access.h",
    "koan_container_partition.cc",
    "koan_container_partition.h",
  ]
  public_deps = [
    ":access_prefs",
    ":domain",
    "//base",
  ]
  deps = [
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//url",
  ]
}

# The user's own containers, Zen's per-Space profiles, and which one a new tab
# opens in (koan_user_containers.h, #318). Pure logic.
source_set("user_containers") {
  sources = [
    "koan_user_containers.cc",
    "koan_user_containers.h",
  ]
  public_deps = [
    ":partition",
    "//base",
    "//components/tab_groups",
  ]
}

# Which paired client may use which saved container (koan_container_grants.h).
# //base only.
source_set("grants") {
  sources = [
    "koan_container_grants.cc",
    "koan_container_grants.h",
  ]
  public_deps = [ "//base" ]
}

# The launch picker's profile count (koan_visible_profiles.h). Header-only, for
# //chrome/browser/ui/profiles.
source_set("visible_profiles") {
  sources = [ "koan_visible_profiles.h" ]
  public_deps = [ "//chrome/browser/profiles:profile_util" ]
}

# The core's hooks into the browser (koan_containers.h) and the API agent
# control calls (koan_agent_containers.h). Header-only, so upstream targets
# and //koan/browser/agent can depend on it without cycles; the definitions
# are in :impl, linked through //koan/browser/ui/views:impl.
source_set("containers") {
  sources = [
    "koan_agent_containers.h",
    "koan_containers.h",
  ]
  public_deps = [
    ":grants",
    ":partition",
    "//base",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "koan_agent_containers.cc",
    "koan_containers.cc",
  ]
  deps = [
    ":containers",
    ":grants",
    ":partition",
    ":user_containers",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/prefs",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//koan/browser:features",
    "//koan/browser:prefs",
    "//koan/browser/agent:policy",
    "//koan/browser/agent:tab_hooks",
    "//koan/browser/ui/views",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/gfx/geometry",
    "//url",
  ]
}

# Build and run:
#   autoninja -C out/Koan koan/browser/containers:koan_containers_unittests
#   out/Koan/koan_containers_unittests
test("koan_containers_unittests") {
  sources = [
    "koan_agent_access_unittest.cc",
    "koan_container_grants_unittest.cc",
    "koan_container_partition_unittest.cc",
    "koan_container_restore_unittest.cc",
    "koan_user_containers_unittest.cc",
  ]
  deps = [
    ":grants",
    ":partition",
    ":user_containers",
    "//base",
    "//base/test:test_support",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/user_prefs",
    "//content/public/browser",
    "//content/test:run_all_unittests",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}

# The decision for every per-profile KeyedService (koan_agent_service_policy.h).
# The table is also read by scripts/agent/check_agent_services.py.
source_set("service_policy") {
  sources = [
    "koan_agent_service_policy.cc",
    "koan_agent_service_policy.h",
  ]
  public_deps = [ "//base" ]
}

# The upgrade guard: every factory Chromium registers has a row (and the launch
# picker's profile count, koan_visible_profiles.h). It links the
# browser (to build every factory), so it is its own target. Build and run:
#   autoninja -C out/Koan koan/browser/containers:koan_agent_service_unittests
#   out/Koan/koan_agent_service_unittests
test("koan_agent_service_unittests") {
  sources = [
    "koan_agent_service_policy_unittest.cc",
    "koan_visible_profiles_unittest.cc",
  ]
  deps = [
    ":service_policy",
    ":visible_profiles",
    "//base",
    "//chrome/browser",
    "//chrome/browser/profiles:profiles_extra_parts",
    "//chrome/test:test_support_unit",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
