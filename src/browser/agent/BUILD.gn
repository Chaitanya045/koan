import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")

# Agent control (.agent/notes/agent-control.md): the pieces that are pure logic
# and depend on //base and //url only, so they build and test on their own.
#
# The browser depends on :browser only (through //koan/browser/ui/views:impl);
# the rest is pure logic that //koan/browser:agent_unit_tests tests.

# The wire format of the unix socket: length-prefixed frames, with a decoder
# built for hostile input. Shared by the gateway in the browser and the `koan`
# command-line tool.
source_set("frame") {
  sources = [
    "koan_agent_frame.cc",
    "koan_agent_frame.h",
  ]
  public_deps = [ "//base" ]
}

# What an agent client may ask of a tab: per-method tables with unlisted =
# deny, and the navigation scheme filter.
source_set("policy") {
  sources = [
    "koan_agent_policy.cc",
    "koan_agent_policy.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
}

# Who a peer is, what a paired client is, the proof it signs and the limits on
# guessing (agent control's authentication, without a socket, keychain or UI).
source_set("auth") {
  sources = [
    "koan_agent_auth.cc",
    "koan_agent_auth.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//crypto",
    "//third_party/boringssl",
  ]
}

# One connection's authentication as a state machine over frames: pairing and
# proving a client. It forwards nothing.
source_set("session") {
  sources = [
    "koan_agent_session.cc",
    "koan_agent_session.h",
  ]
  public_deps = [
    ":auth",
    ":frame",
    "//base",
  ]
  deps = [ "//third_party/icu" ]
}

# The limits the user can change, and how a stored value is read.
source_set("limits") {
  sources = [
    "koan_agent_limits.cc",
    "koan_agent_limits.h",
  ]
  public_deps = [ "//base" ]
}

# When an agent tab holds the visible capturer of its keep-alive lease.
source_set("lease_scheduler") {
  sources = [
    "koan_agent_lease_scheduler.cc",
    "koan_agent_lease_scheduler.h",
  ]
  public_deps = [
    ":limits",
    "//base",
  ]
}

# The calls upstream tab code makes into agent control (//content only).
source_set("tab_hooks") {
  sources = [
    "koan_agent_tab_hooks.cc",
    "koan_agent_tab_hooks.h",
  ]
  public_deps = [
    "//base",
    "//ui/base:types",
    "//url",
  ]
}

# How many connections the gateway keeps open.
source_set("admission") {
  sources = [
    "koan_agent_admission.cc",
    "koan_agent_admission.h",
  ]
  public_deps = [ "//base" ]
}

if (is_posix) {
  # Where the gateway's unix socket lives and the checks that keep it safe.
  source_set("socket") {
    sources = [
      "koan_agent_socket.cc",
      "koan_agent_socket.h",
    ]
    public_deps = [ "//base" ]
    deps = [
      "//crypto",
      "//net",
    ]
  }

  # Who is on the other end of a connection, from the OS (macOS only; elsewhere
  # there is no resolver and the gateway does not start).
  source_set("peer") {
    sources = [
      "koan_agent_peer.cc",
      "koan_agent_peer.h",
    ]
    public_deps = [
      ":auth",
      "//base",
    ]
    if (is_mac) {
      frameworks = [
        "CoreFoundation.framework",
        "Security.framework",
      ]
    }
  }

  # The unix socket the agent CLI connects to: accept loop, a session per
  # connection and the limits on connections. Nothing in the browser starts it.
  source_set("gateway") {
    sources = [
      "koan_agent_gateway.cc",
      "koan_agent_gateway.h",
    ]
    public_deps = [
      ":admission",
      ":auth",
      ":peer",
      ":session",
      "//base",
      "//net",
    ]
    deps = [ ":socket" ]
  }

  # The browser side: starts the gateway from the "Agent ready" pref on the IO
  # thread, the approval dialog, and the connected clients the indicator shows.
  # Linked into //chrome/browser through //koan/browser/ui/views:impl.
  source_set("browser") {
    sources = [
      "koan_agent_approval_dialog.cc",
      "koan_agent_devtools_client.cc",
      "koan_agent_devtools_client.h",
      "koan_agent_forwarder.cc",
      "koan_agent_forwarder.h",
      "koan_agent_lease.cc",
      "koan_agent_lease.h",
      "koan_agent_reach_content.cc",
      "koan_agent_reach_content.h",
      "koan_agent_service.cc",
      "koan_agent_service.h",
    ]
    if (is_mac) {
      sources += [ "koan_agent_lease_mac.mm" ]
      frameworks = [ "Foundation.framework" ]
    }
    public_deps = [
      ":audit",
      ":lease_scheduler",
      ":reach",
      ":registry",
      ":session",
      ":tab_hooks",
      "//base",
      "//components/prefs",
      "//content/public/browser",
    ]
    deps = [
      ":auth",
      ":facade",
      ":gateway",
      ":limits",
      ":peer",
      ":socket",
      "//chrome/browser:browser_process",
      "//chrome/browser/lifetime:termination_notification",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/dialogs:browser_dialogs",
      "//chrome/common",
      "//chrome/common:constants",
      "//components/embedder_support:user_agent",
      "//components/performance_manager",
      "//components/security_interstitials/content:security_interstitial_page",
      "//components/version_info",
      "//content/public/browser",
      "//content/public/common",
      "//koan/browser:prefs",
      "//koan/browser/containers",
      "//ui/base",
      "//ui/gfx/geometry",
      "//ui/views",
    ]
  }
}

# What an agent client may receive: the event allowlist, and the scrubber that
# takes cookies, credentials and request bodies out of Network events.
source_set("events") {
  sources = [
    "koan_agent_events.cc",
    "koan_agent_events.h",
  ]
  public_deps = [ "//base" ]
}

# The parameter filters of the policy table, and the session's stream registry.
source_set("filters") {
  sources = [
    "koan_agent_filters.cc",
    "koan_agent_filters.h",
  ]
  public_deps = [
    ":policy",
    "//base",
    "//url",
  ]
  deps = [ ":contexts" ]
}

# The execution contexts an agent may see and name in a tab: main worlds and
# the isolated worlds it made.
source_set("contexts") {
  sources = [
    "koan_agent_contexts.cc",
    "koan_agent_contexts.h",
  ]
  public_deps = [ "//base" ]
}

# Which frames an agent may attach to, decided from facts the browser gathers.
source_set("reach") {
  sources = [
    "koan_agent_reach.cc",
    "koan_agent_reach.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
}

# What an agent may not read off a user's tab: secret input values.
source_set("redact") {
  sources = [
    "koan_agent_redact.cc",
    "koan_agent_redact.h",
  ]
  public_deps = [ "//base" ]
}

# Which tabs each client may see and drive, and the open-tab budgets.
source_set("registry") {
  sources = [
    "koan_agent_registry.cc",
    "koan_agent_registry.h",
  ]
  public_deps = [ "//base" ]
}

# The activity log: redacted, size-capped, hash-chained JSON lines.
source_set("audit") {
  sources = [
    "koan_agent_audit.cc",
    "koan_agent_audit.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//crypto",
    "//url",
  ]
}

# The CDP facade of one connection: the method policy, the registry, the
# parameter filters, the context tracker and the scrubber between an agent and
# its tabs, and the Target.* and Koan.* methods over the tabs in its scope.
source_set("facade") {
  sources = [
    "koan_agent_facade.cc",
    "koan_agent_facade.h",
  ]
  public_deps = [
    ":audit",
    ":session",
    "//base",
    "//url",
  ]
  deps = [
    ":contexts",
    ":events",
    ":filters",
    ":policy",
    ":registry",
  ]
}

# Build and run:
#   autoninja -C out/Koan koan/browser:agent_unit_tests
#   out/Koan/koan_agent_unittests
# The policy table is also checked against the protocol of a Chromium checkout
# by scripts/agent/check_policy_coverage.py.
test("koan_agent_unittests") {
  sources = [
    "koan_agent_admission_unittest.cc",
    "koan_agent_audit_unittest.cc",
    "koan_agent_auth_unittest.cc",
    "koan_agent_contexts_unittest.cc",
    "koan_agent_events_unittest.cc",
    "koan_agent_facade_unittest.cc",
    "koan_agent_filters_unittest.cc",
    "koan_agent_frame_unittest.cc",
    "koan_agent_lease_scheduler_unittest.cc",
    "koan_agent_limits_unittest.cc",
    "koan_agent_policy_unittest.cc",
    "koan_agent_reach_unittest.cc",
    "koan_agent_redact_unittest.cc",
    "koan_agent_registry_unittest.cc",
    "koan_agent_session_unittest.cc",
  ]
  deps = [
    ":admission",
    ":audit",
    ":auth",
    ":contexts",
    ":events",
    ":facade",
    ":filters",
    ":frame",
    ":lease_scheduler",
    ":limits",
    ":policy",
    ":reach",
    ":redact",
    ":registry",
    ":session",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//third_party/boringssl",
    "//url",
  ]
  if (is_posix) {
    sources += [
      "koan_agent_gateway_unittest.cc",
      "koan_agent_peer_unittest.cc",
      "koan_agent_socket_unittest.cc",
    ]
    deps += [
      ":gateway",
      ":peer",
      ":socket",
      "//net",
      "//net:test_support",
    ]
  }
}

# Fuzzers for the two parsers that face a hostile peer. Like Chromium's own
# fuzzer_test targets, these build only with a fuzzing engine (use_libfuzzer),
# and are a no-op otherwise.
fuzzer_test("koan_agent_frame_fuzzer") {
  sources = [ "koan_agent_frame_fuzzer.cc" ]
  deps = [
    ":frame",
    "//base",
  ]
}

fuzzer_test("koan_agent_url_fuzzer") {
  sources = [ "koan_agent_url_fuzzer.cc" ]
  deps = [
    ":policy",
    "//base",
    "//url",
  ]
}

fuzzer_test("koan_agent_events_fuzzer") {
  sources = [ "koan_agent_events_fuzzer.cc" ]
  deps = [
    ":events",
    "//base",
  ]
}

fuzzer_test("koan_agent_filters_fuzzer") {
  sources = [ "koan_agent_filters_fuzzer.cc" ]
  deps = [
    ":contexts",
    ":filters",
    "//base",
    "//url",
  ]
}

fuzzer_test("koan_agent_session_fuzzer") {
  sources = [ "koan_agent_session_fuzzer.cc" ]
  deps = [
    ":session",
    "//base",
    "//base/test:test_support",
    "//third_party/boringssl",
  ]
}
