import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")

# Agent control (.agent/notes/agent-control.md): the pieces that are pure logic
# and depend on //base and //url only, so they build and test on their own.
#
# Nothing in the browser depends on this directory yet. GN loads it because
# //koan/browser:agent_unit_tests names the test below.

# The wire format of the unix socket: length-prefixed frames, with a decoder
# built for hostile input. Shared by the gateway in the browser and the `koan`
# command-line tool.
source_set("frame") {
  sources = [
    "koan_agent_frame.cc",
    "koan_agent_frame.h",
  ]
  public_deps = [ "//base" ]
}

# What an agent client may ask of a tab: per-method tables with unlisted =
# deny, and the navigation scheme filter.
source_set("policy") {
  sources = [
    "koan_agent_policy.cc",
    "koan_agent_policy.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
}

# Who a peer is, what a paired client is, the proof it signs and the limits on
# guessing (agent control's authentication, without a socket, keychain or UI).
source_set("auth") {
  sources = [
    "koan_agent_auth.cc",
    "koan_agent_auth.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//crypto",
    "//third_party/boringssl",
  ]
}

# One connection's authentication as a state machine over frames: pairing and
# proving a client. It forwards nothing.
source_set("session") {
  sources = [
    "koan_agent_session.cc",
    "koan_agent_session.h",
  ]
  public_deps = [
    ":auth",
    ":frame",
    "//base",
  ]
  deps = [ "//third_party/icu" ]
}

# How many connections the gateway keeps open.
source_set("admission") {
  sources = [
    "koan_agent_admission.cc",
    "koan_agent_admission.h",
  ]
  public_deps = [ "//base" ]
}

if (is_posix) {
  # Where the gateway's unix socket lives and the checks that keep it safe.
  source_set("socket") {
    sources = [
      "koan_agent_socket.cc",
      "koan_agent_socket.h",
    ]
    public_deps = [ "//base" ]
    deps = [
      "//crypto",
      "//net",
    ]
  }

  # Who is on the other end of a connection, from the OS (macOS only; elsewhere
  # there is no resolver and the gateway does not start).
  source_set("peer") {
    sources = [
      "koan_agent_peer.cc",
      "koan_agent_peer.h",
    ]
    public_deps = [
      ":auth",
      "//base",
    ]
    if (is_mac) {
      frameworks = [
        "CoreFoundation.framework",
        "Security.framework",
      ]
    }
  }

  # The unix socket the agent CLI connects to: accept loop, a session per
  # connection and the limits on connections. Nothing in the browser starts it.
  source_set("gateway") {
    sources = [
      "koan_agent_gateway.cc",
      "koan_agent_gateway.h",
    ]
    public_deps = [
      ":admission",
      ":auth",
      ":peer",
      ":session",
      "//base",
      "//net",
    ]
    deps = [ ":socket" ]
  }
}

# What an agent client may receive: the event allowlist, and the scrubber that
# takes cookies, credentials and request bodies out of Network events.
source_set("events") {
  sources = [
    "koan_agent_events.cc",
    "koan_agent_events.h",
  ]
  public_deps = [ "//base" ]
}

# The parameter filters of the policy table, and the session's stream registry.
source_set("filters") {
  sources = [
    "koan_agent_filters.cc",
    "koan_agent_filters.h",
  ]
  public_deps = [
    ":policy",
    "//base",
    "//url",
  ]
}

# Build and run:
#   autoninja -C out/Koan koan/browser:agent_unit_tests
#   out/Koan/koan_agent_unittests
# The policy table is also checked against the protocol of a Chromium checkout
# by scripts/agent/check_policy_coverage.py.
test("koan_agent_unittests") {
  sources = [
    "koan_agent_admission_unittest.cc",
    "koan_agent_auth_unittest.cc",
    "koan_agent_events_unittest.cc",
    "koan_agent_filters_unittest.cc",
    "koan_agent_frame_unittest.cc",
    "koan_agent_policy_unittest.cc",
    "koan_agent_session_unittest.cc",
  ]
  deps = [
    ":admission",
    ":auth",
    ":events",
    ":filters",
    ":frame",
    ":policy",
    ":session",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//third_party/boringssl",
    "//url",
  ]
  if (is_posix) {
    sources += [
      "koan_agent_gateway_unittest.cc",
      "koan_agent_peer_unittest.cc",
      "koan_agent_socket_unittest.cc",
    ]
    deps += [
      ":gateway",
      ":peer",
      ":socket",
      "//net",
      "//net:test_support",
    ]
  }
}

# Fuzzers for the two parsers that face a hostile peer. Like Chromium's own
# fuzzer_test targets, these build only with a fuzzing engine (use_libfuzzer),
# and are a no-op otherwise.
fuzzer_test("koan_agent_frame_fuzzer") {
  sources = [ "koan_agent_frame_fuzzer.cc" ]
  deps = [
    ":frame",
    "//base",
  ]
}

fuzzer_test("koan_agent_url_fuzzer") {
  sources = [ "koan_agent_url_fuzzer.cc" ]
  deps = [
    ":policy",
    "//base",
    "//url",
  ]
}

fuzzer_test("koan_agent_events_fuzzer") {
  sources = [ "koan_agent_events_fuzzer.cc" ]
  deps = [
    ":events",
    "//base",
  ]
}

fuzzer_test("koan_agent_filters_fuzzer") {
  sources = [ "koan_agent_filters_fuzzer.cc" ]
  deps = [
    ":filters",
    "//base",
    "//url",
  ]
}

fuzzer_test("koan_agent_session_fuzzer") {
  sources = [ "koan_agent_session_fuzzer.cc" ]
  deps = [
    ":session",
    "//base",
    "//base/test:test_support",
    "//third_party/boringssl",
  ]
}
