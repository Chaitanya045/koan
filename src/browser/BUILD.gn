import("//testing/test.gni")

# Koan base::Features. Depends on //base only, so any upstream target can
# depend on it cheaply.
source_set("features") {
  sources = [
    "koan_features.cc",
    "koan_features.h",
    "koan_switches.h",
  ]
  public_deps = [ "//base" ]
}

# chrome://flags entries for the Koan features; included only by
# chrome/browser/about_flags.cc.
source_set("flag_entries") {
  sources = [ "koan_flag_entries.h" ]
  public_deps = [
    ":features",
    "//components/performance_manager",
    "//components/webui/flags",
  ]
}

# Koan profile prefs, and Koan's defaults for upstream local-state prefs.
source_set("prefs") {
  sources = [
    "koan_prefs.cc",
    "koan_prefs.h",
  ]
  deps = [
    "//base",
    "//chrome/common:constants",
    "//components/performance_manager",
    "//components/pref_registry",
    "//components/prefs",
    "//koan/browser/agent:limits",
  ]
}

# Koan's keyboard shortcuts as data, for the shortcut controller and the
# settings page.
source_set("shortcut_table") {
  sources = [
    "koan_shortcut_table.cc",
    "koan_shortcut_table.h",
  ]
  public_deps = [
    "//base",
    "//ui/base",
  ]
  deps = [
    ":features",
    "//ui/events:event_constants",
    "//ui/events:events_base",
  ]
}

# The shortcut table's tests, against Zen 1.24b's keys. Build and run:
#   autoninja -C out/Koan koan/browser:koan_shortcut_unittests
#   out/Koan/koan_shortcut_unittests
test("koan_shortcut_unittests") {
  sources = [ "koan_shortcut_table_unittest.cc" ]
  deps = [
    ":shortcut_table",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/events:event_constants",
    "//ui/events:events_base",
  ]
}

# Agent control's unit tests (src/browser/agent, and its containers in
# src/browser/containers). Nothing else depends on the agent
# directory yet, and GN reads a BUILD.gn only when some target names a label in
# its directory, so this group is what makes the tests buildable:
#   autoninja -C out/Koan koan/browser:agent_unit_tests
group("agent_unit_tests") {
  testonly = true
  deps = [
    "//koan/browser/agent:koan_agent_events_fuzzer",
    "//koan/browser/agent:koan_agent_filters_fuzzer",
    "//koan/browser/agent:koan_agent_frame_fuzzer",
    "//koan/browser/agent:koan_agent_session_fuzzer",
    "//koan/browser/agent:koan_agent_unittests",
    "//koan/browser/agent:koan_agent_url_fuzzer",
    "//koan/browser/containers:koan_containers_unittests",
  ]
}

# The per-profile service guard of agent containers. Separate from the group
# above because it links the whole browser:
#   autoninja -C out/Koan koan/browser:agent_service_unittests
group("agent_service_unittests") {
  testonly = true
  deps = [ "//koan/browser/containers:koan_agent_service_unittests" ]
  ]
}

# Zen's fuzzy score for the command palette. Pure logic, //base only.
source_set("fuzzy_score") {
  sources = [
    "koan_fuzzy_score.cc",
    "koan_fuzzy_score.h",
  ]
  public_deps = [ "//base" ]
}

# A Space's icon and name in its tab group title. Pure logic.
source_set("space_title") {
  sources = [
    "koan_space_title.cc",
    "koan_space_title.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    "//base:i18n",
    "//third_party/icu",
  ]
}

# Zen's tab behaviours, called from upstream tab code (tab_strip_model.cc,
# back_to_opener_controller.cc). No tab strip deps, so those can use it.
source_set("tab_hooks") {
  sources = [
    "koan_tab_hooks.cc",
    "koan_tab_hooks.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":features",
    ":prefs",
    "//chrome/common:constants",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//koan/browser/ui/views",
  ]
}

# The vertical tab strip's state under Koan's control (see
# koan_vertical_tabs.h), called from the strip's state controller.
source_set("vertical_tabs") {
  sources = [
    "koan_vertical_tabs.cc",
    "koan_vertical_tabs.h",
  ]
  deps = [
    ":features",
    ":prefs",
    "//base",
    "//components/prefs",
  ]
}

# Koan switches for renderer processes, appended from
# ChromeContentBrowserClient::AppendExtraCommandLineSwitches().
source_set("renderer_switches") {
  sources = [
    "koan_renderer_switches.cc",
    "koan_renderer_switches.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":features",
    ":prefs",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
  ]
}

# Default-state overrides for upstream features, registered from
# chrome/browser/chrome_browser_field_trials.cc.
source_set("feature_overrides") {
  sources = [
    "koan_feature_overrides.cc",
    "koan_feature_overrides.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/tabs:features",
    "//components/feature_engagement/public:feature_constants",
    "//components/performance_manager",
    "//components/variations",
    "//koan/browser/ui/vector_icons:koan_icons",
    "//ui/base:features",
  ]
  if (is_mac) {
    deps += [ "//components/os_crypt/common:switches" ]
  }
}

# Koan's tests, so `gn gen` generates them: build //koan/test:koan_unittests
# and //koan/test:koan_browsertests (scripts/test_unit.sh, test_browser.sh).
group("tests") {
  testonly = true
  deps = [
    "//koan/test:koan_browsertests",
    "//koan/test:koan_unittests",
  ]
}
