  if (is_mac) {
    # KoanShortcutController refreshes the menu bar's keys.
    deps += [ "//koan/browser/ui/cocoa:hooks" ]
  }
  if (use_aura) {
    # Glance animates the page's native window (an aura::Window). macOS
    # uses NSViews instead and has no Aura.
    deps += [ "//ui/aura" ]
  }
  if (is_mac) {
    # The blurred desktop behind the window (koan_window_glass_mac.mm).
    sources += [ "koan_window_glass_mac.mm" ]
    frameworks += [ "AppKit.framework" ]
  }
  if (is_linux) {
    # Dragging the window from the page asks the window manager to move it
    # (koan_window_drag.cc); macOS runs a move loop instead.
    deps += [
      "//ui/platform_window",
      "//ui/platform_window/wm",
    ]
  }
