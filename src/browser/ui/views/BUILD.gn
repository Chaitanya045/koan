    "koan_omnibox_upstream_unittest.cc",
    "koan_zero_suggest.cc",
    "koan_zero_suggest.h",
    "koan_zero_suggest_unittest.cc",
  ]
  deps = [
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/history/core/browser",
    "//components/omnibox/browser",
    "//components/omnibox/browser:test_support",
    "//components/url_formatter",
    "//koan/browser:features",
    "//koan/browser/omnibox:hooks",
    "//testing/gtest",
    "//third_party/metrics_proto",
    "//ui/base",
    "//ui/base:types",
    "//ui/base/clipboard",
    "//ui/base/clipboard:clipboard_test_support",
    "//url",
  ]
}

# Zen's grain texture (grain-bg.png, MPL-2.0; see THIRD_PARTY_NOTICES.md),
# compiled in as a byte array.
action("grain_png") {
  script = "resources/embed_file.py"
  inputs = [ "resources/grain-bg.png" ]
  outputs = [ "$target_gen_dir/koan_grain_png.h" ]
  args = [
    rebase_path("resources/grain-bg.png", root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "kGrainPng",
    "KOAN_BROWSER_UI_VIEWS_KOAN_GRAIN_PNG_H_",
  ]
}

