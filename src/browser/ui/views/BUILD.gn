import("//build/config/ui.gni")

# Hook declarations called from upstream views code. Header-only and
# dependency-light so upstream targets can depend on it without cycles; the
# definitions live in :impl, linked through //chrome/browser:browser.
source_set("views") {
  sources = [
    "koan_browser_view_hooks.h",
    "koan_compact_mode.h",
    "koan_glance.h",
    "koan_content_card.h",
    "koan_essentials.h",
    "koan_sidebar_header.h",
    "koan_sidebar_tabs.h",
    "koan_split_view.h",
    "koan_url_bar.h",
  ]
  public_deps = [
    "//base",
    "//ui/base",
    "//ui/gfx/geometry",
  ]
}

source_set("impl") {
  sources = [
    "koan_browser_view_controller.cc",
    "koan_browser_view_controller.h",
    "koan_browser_view_hooks.cc",
    "koan_command_palette.cc",
    "koan_command_palette.h",
    "koan_command_registry.cc",
    "koan_command_registry.h",
    "koan_commands.cc",
    "koan_commands.h",
    "koan_compact_mode_controller.cc",
    "koan_compact_mode_controller.h",
    "koan_content_card.cc",
    "koan_essentials.cc",
    "koan_glance_controller.cc",
    "koan_sidebar_nav_view.cc",
    "koan_sidebar_nav_view.h",
    "koan_sidebar_metrics.h",
    "koan_sidebar_tabs.cc",
    "koan_sidebar_tabs_controller.h",
    "koan_url_bar_controller.cc",
    "koan_url_bar_controller.h",
    "koan_window_controls.cc",
    "koan_window_controls.h",
    "koan_glance_controller.h",
    "koan_shortcuts.cc",
    "koan_shortcuts.h",
    "koan_split_view.cc",
    "koan_tab_activation.cc",
    "koan_tab_activation.h",
    "koan_toast.cc",
    "koan_toast.h",
    "koan_workspaces.cc",
    "koan_workspaces.h",
  ]
  deps = [
    ":views",
    "//base:i18n",
    "//cc/paint",
    "//chrome/app:command_ids",
    "//chrome/app/vector_icons",
    "//chrome/browser:command_updater_impl",
    "//chrome/browser/ui:browser_command_controller",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/views/omnibox",
    "//chrome/common",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:singleton_tabs",
    "//chrome/browser/ui/views/location_bar",
    "//chrome/browser/ui/views/omnibox",
    "//components/omnibox/browser",
    "//components/url_formatter",
    "//chrome/browser/ui:tab_ui_helper",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//ui/base/mojom",
    "//chrome/browser/ui/tabs:tab_enums",
    "//components/input",
    "//components/split_tabs",
    "//components/vector_icons",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//third_party/icu",
    "//ui/views/controls/webview",
    "//ui/views/window/vector_icons",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/tab_groups",
    "//components/tabs:public",
    "//url",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/views/frame",
    "//chrome/browser/ui/views/frame:browser_frame_view",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:browser_view_layout_params",
    "//chrome/browser/ui/views/frame:browser_widget",
    "//chrome/browser/ui/views/frame:contents_container_view",
    "//chrome/browser/ui/views/frame:multi_contents_view",
    "//chrome/browser/ui/views/frame:top_container_view",
    "//chrome/browser/ui/views/frame:vertical_tab_strip_region_view",
    "//chrome/browser/ui/views/tabs/common",
    "//chrome/browser/ui:layout_constants",
    "//ui/color",
    "//chrome/browser/ui/views/infobars",
    "//chrome/browser/ui/views/page_info",
    "//components/prefs",
    "//koan/browser:features",
    "//koan/browser:prefs",
    "//koan/browser:shortcut_table",
    "//koan/browser:tab_hooks",
    "//koan/common:url_constants",
    "//koan/browser/ui/color",
    "//components/blocked_content",
    "//components/javascript_dialogs",
    "//components/user_prefs",
    "//ui/accessibility",
    "//koan/browser/omnibox:hooks",
    "//koan/browser/ui/vector_icons",
    "//third_party/metrics_proto",
    "//ui/actions",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/base/metadata",
    "//ui/compositor",
    "//ui/events",
    "//skia",
    "//ui/gfx",
    "//ui/gfx/geometry:geometry_skia",
    "//ui/menus",
    "//ui/views",
  ]
  if (use_aura) {
    # Glance animates the page's native window (an aura::Window). macOS
    # uses NSViews instead and has no Aura.
    deps += [ "//ui/aura" ]
  }
}
