# Zen's compact mode slide curve (MPL-2.0, see koan_sidebar_curve.cc): pure
# logic over //base and //ui/gfx/geometry, so the unit tests can use it.
# Which recreated Space a stored per-Space entry (a folder) belongs to.
source_set("stored_space") {
  sources = [
    "koan_stored_space.cc",
    "koan_stored_space.h",
  ]
}

source_set("sidebar_curve") {
  sources = [
    "koan_sidebar_curve.cc",
    "koan_sidebar_curve.h",
  ]
  deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

# Zen's two-finger swipe between Spaces (MPL-2.0, see koan_swipe_tracker.h):
# the gesture state machine and the formulas, plain C++ so that the unit tests
# can use them.
source_set("swipe_tracker") {
  sources = [
    "koan_swipe_tracker.cc",
    "koan_swipe_tracker.h",
  ]
  deps = [ "//base" ]
}

# Where a sidebar button goes to clear the macOS traffic lights: geometry only.
source_set("lights_geometry") {
  sources = [
    "koan_lights_geometry.cc",
    "koan_lights_geometry.h",
  ]
  deps = [ "//base" ]
  public_deps = [ "//ui/gfx/geometry" ]
}

source_set("glass_tint") {
  sources = [
    "koan_glass_tint.cc",
    "koan_glass_tint.h",
  ]
  deps = [ "//skia" ]
}

# Whether a pinned tab keeps its site (koan_pinned_site.h): pure, so the unit
# tests need nothing else.
source_set("pinned_site") {
  sources = [ "koan_pinned_site.h" ]
  public_deps = [ "//url" ]
}

# Build and run:
#   autoninja -C out/Koan koan/browser/ui/views:koan_views_unittests
#   out/Koan/koan_views_unittests
test("koan_views_unittests") {
  sources = [
    "koan_glass_tint_unittest.cc",
    "koan_lights_geometry_unittest.cc",
    "koan_pinned_site_unittest.cc",
    "koan_sidebar_curve_unittest.cc",
    "koan_stored_space_unittest.cc",
    "koan_swipe_tracker_unittest.cc",
  ]
  deps = [
    ":glass_tint",
    ":lights_geometry",
    ":pinned_site",
    ":sidebar_curve",
    ":stored_space",
    ":swipe_tracker",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/gfx:test_support",  # gfx::PrintTo(), for EXPECT_EQ on a gfx::Rect
  ]
}

# The empty URL bar's provider and the omnibox disposition rule. The provider
# is compiled here again (it is in :impl too) to keep the test off the whole
# UI. Build and run:
#   autoninja -C out/Koan koan/browser/ui/views:koan_omnibox_unittests
#   out/Koan/koan_omnibox_unittests
test("koan_omnibox_unittests") {
  sources = [
    "koan_omnibox_disposition.h",
    "koan_omnibox_disposition_unittest.cc",
    "koan_omnibox_upstream_unittest.cc",
    "koan_zero_suggest.cc",
    "koan_zero_suggest.h",
    "koan_zero_suggest_unittest.cc",
  ]
  deps = [
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/history/core/browser",
    "//components/omnibox/browser",
    "//components/omnibox/browser:test_support",
    "//components/url_formatter",
    "//koan/browser:features",
    "//koan/browser/omnibox:hooks",
    "//testing/gtest",
    "//third_party/metrics_proto",
    "//ui/base",
    "//ui/base:types",
    "//url",
  ]
}

