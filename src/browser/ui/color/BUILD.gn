# Koan colour overrides, registered from
# chrome/browser/ui/color/chrome_color_mixers.cc.
source_set("color") {
  sources = [
    "koan_color_id.h",
    "koan_color_mixer.cc",
    "koan_color_mixer.h",
  ]
  deps = [
    "//chrome/browser/ui/color:color_headers",
    "//koan/browser:features",
    "//ui/color",
  ]
}
