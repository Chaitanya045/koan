source_set("vector_icons") {
  sources = get_target_outputs(":koan_vector_icons") + [ "koan_icon_sizes.h" ]

  deps = [
    ":koan_vector_icons",
    "//base",
    "//skia",
    "//ui/gfx",
  ]
}

# The registry that swaps Chromium's icons for the Koan ones (koan_icons.h),
# installed from koan::RegisterFeatureOverrides().
source_set("koan_icons") {
  sources = [
    "koan_icons.cc",
    "koan_icons.h",
  ]

  deps = [
    ":vector_icons",
    "//base",
    "//chrome/app/vector_icons",
    "//components/omnibox/browser:vector_icons",
    "//components/vector_icons",
    "//ui/gfx",
    "//ui/views",
  ]
}

# Unit tests of the registry: build with scripts/build.sh koan_icons_unittests
# and run out/Koan/koan_icons_unittests. (They join koan_unittests when that
# exists.)
test("koan_icons_unittests") {
  sources = [ "koan_icons_unittest.cc" ]

  deps = [
    ":koan_icons",
    ":vector_icons",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//chrome/app/vector_icons",
    "//components/vector_icons",
    "//testing/gtest",
    "//ui/gfx",
  ]
}
