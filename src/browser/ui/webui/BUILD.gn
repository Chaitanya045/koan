# Koan's panes in chrome://settings (added by the hook in SettingsUI),
# chrome://koan-newtab and chrome://koan-welcome. Linked through
# //chrome/browser/ui/webui:configs, which registers the last two, and
# //chrome/browser/ui/webui/settings:impl.
source_set("webui") {
  sources = [
    "koan_new_tab_ui.cc",
    "koan_new_tab_ui.h",
    "koan_settings_handler.cc",
    "koan_settings_handler.h",
    "koan_settings_rows.cc",
    "koan_settings_rows.h",
    "koan_settings_ui.cc",
    "koan_settings_ui.h",
    "koan_welcome_handler.cc",
    "koan_welcome_handler.h",
    "koan_welcome_host.cc",
    "koan_welcome_host.h",
    "koan_welcome_ui.cc",
    "koan_welcome_ui.h",
  ]
  public_deps = [
    "//content/public/browser",
    "//ui/views",
  ]
  deps = [
    ":resources",
    ":welcome_resources",
    "//base",
    "//base:i18n",
    "//chrome/browser:browser_process",
    "//chrome/browser:shell_integration",
    "//chrome/browser/importer",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/regional_capabilities",
    "//chrome/browser/search_engines",
    "//chrome/browser/themes",
    "//chrome/browser/ui:accelerator_table",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/tabs",
    "//chrome/common:constants",
    "//components/performance_manager",
    "//components/prefs",
    "//components/regional_capabilities",
    "//components/search_engines",
    "//components/signin/public/base",
    "//components/strings",
    "//components/tab_groups",
    "//components/user_data_importer/common",
    "//content/public/common",
    "//koan/browser:features",
    "//koan/browser:prefs",
    "//koan/browser:shortcut_table",
    "//koan/browser/containers:access_prefs",
    "//koan/browser/importer",
    "//koan/browser/ui/color:tokens",
    "//koan/browser/ui/fonts",
    "//koan/browser/ui/views",
    "//koan/common:url_constants",
    "//services/network/public/mojom",
    "//ui/base",
    "//ui/color",
    "//ui/events:event_constants",
    "//ui/gfx:color_utils",
    "//ui/gfx/geometry",
    "//url",
  ]
  if (is_mac) {
    deps += [ "//koan/browser/ui/cocoa:hooks" ]
  }
  if (is_posix) {
    # Agent control is POSIX-only (//koan/browser/agent:browser).
    sources += [
      "koan_agent_containers_handler.cc",
      "koan_agent_containers_handler.h",
    ]
    deps += [
      "//koan/browser/agent:browser",
      "//koan/browser/containers",
    ]
  }
}

# chrome://koan-settings, the old page, as an alias of the panes (pure, unit
# tested in //koan/test:koan_unittests).
source_set("settings_url") {
  sources = [
    "koan_settings_url.cc",
    "koan_settings_url.h",
  ]
  deps = [
    "//base",
    "//koan/common:url_constants",
    "//url",
  ]
}

# Its BrowserURLHandler pair, for //chrome/browser
# (chrome_content_browser_client.cc).
source_set("settings_url_handler") {
  sources = [ "koan_settings_url_handler.cc" ]
  public_deps = [ ":settings_url" ]
  deps = [
    "//content/public/browser",
    "//url",
  ]
}

# The panes' files as C++ strings (koan_settings_resources.h).
action("resources") {
  script = "embed_resources.py"
  sources = [
    "resources/koan_settings.css",
    "resources/koan_settings_page.js",
  ]
  outputs = [ "$target_gen_dir/koan_settings_resources.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    "kKoanSettingsCss=" +
        rebase_path("resources/koan_settings.css", root_build_dir),
    "kKoanSettingsJs=" +
        rebase_path("resources/koan_settings_page.js", root_build_dir),
  ]
}

# chrome://koan-welcome's files as C++ strings (koan_welcome_resources.h):
# the page, its Lucide icons (ISC) and the search engines' marks (Simple
# Icons, CC0; see THIRD_PARTY_NOTICES.md).
action("welcome_resources") {
  script = "embed_resources.py"
  sources = [
    "resources/koan_welcome.css",
    "resources/koan_welcome.html",
    "resources/koan_welcome.js",
    "resources/welcome_icons/arrow-left.svg",
    "resources/welcome_icons/arrow-right.svg",
    "resources/welcome_icons/check.svg",
    "resources/welcome_icons/circle-check-big.svg",
    "resources/welcome_icons/engine-baidu.svg",
    "resources/welcome_icons/engine-brave.svg",
    "resources/welcome_icons/engine-duckduckgo.svg",
    "resources/welcome_icons/engine-ecosia.svg",
    "resources/welcome_icons/engine-google.svg",
    "resources/welcome_icons/engine-mojeek.svg",
    "resources/welcome_icons/engine-naver.svg",
    "resources/welcome_icons/engine-qwant.svg",
    "resources/welcome_icons/engine-startpage.svg",
    "resources/welcome_icons/hard-drive-download.svg",
    "resources/welcome_icons/keyboard.svg",
    "resources/welcome_icons/search.svg",
    "resources/welcome_icons/sparkles.svg",
    "resources/welcome_icons/x.svg",
  ]
  outputs = [ "$target_gen_dir/koan_welcome_resources.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    "kKoanWelcomeHtml=" +
        rebase_path("resources/koan_welcome.html", root_build_dir),
    "kKoanWelcomeCss=" +
        rebase_path("resources/koan_welcome.css", root_build_dir),
    "kKoanWelcomeJs=" +
        rebase_path("resources/koan_welcome.js", root_build_dir),
    "kKoanWelcomeIconArrowLeft=" +
        rebase_path("resources/welcome_icons/arrow-left.svg", root_build_dir),
    "kKoanWelcomeIconArrowRight=" +
        rebase_path("resources/welcome_icons/arrow-right.svg", root_build_dir),
    "kKoanWelcomeIconCheck=" +
        rebase_path("resources/welcome_icons/check.svg", root_build_dir),
    "kKoanWelcomeIconCircleCheckBig=" +
        rebase_path("resources/welcome_icons/circle-check-big.svg",
                    root_build_dir),
    "kKoanWelcomeIconEngineBaidu=" +
        rebase_path("resources/welcome_icons/engine-baidu.svg", root_build_dir),
    "kKoanWelcomeIconEngineBrave=" +
        rebase_path("resources/welcome_icons/engine-brave.svg", root_build_dir),
    "kKoanWelcomeIconEngineDuckDuckGo=" +
        rebase_path("resources/welcome_icons/engine-duckduckgo.svg",
                    root_build_dir),
    "kKoanWelcomeIconEngineEcosia=" +
        rebase_path("resources/welcome_icons/engine-ecosia.svg",
                    root_build_dir),
    "kKoanWelcomeIconEngineGoogle=" +
        rebase_path("resources/welcome_icons/engine-google.svg",
                    root_build_dir),
    "kKoanWelcomeIconEngineMojeek=" +
        rebase_path("resources/welcome_icons/engine-mojeek.svg",
                    root_build_dir),
    "kKoanWelcomeIconEngineNaver=" +
        rebase_path("resources/welcome_icons/engine-naver.svg", root_build_dir),
    "kKoanWelcomeIconEngineQwant=" +
        rebase_path("resources/welcome_icons/engine-qwant.svg", root_build_dir),
    "kKoanWelcomeIconEngineStartpage=" +
        rebase_path("resources/welcome_icons/engine-startpage.svg",
                    root_build_dir),
    "kKoanWelcomeIconHardDriveDownload=" +
        rebase_path("resources/welcome_icons/hard-drive-download.svg",
                    root_build_dir),
    "kKoanWelcomeIconKeyboard=" +
        rebase_path("resources/welcome_icons/keyboard.svg", root_build_dir),
    "kKoanWelcomeIconSearch=" +
        rebase_path("resources/welcome_icons/search.svg", root_build_dir),
    "kKoanWelcomeIconSparkles=" +
        rebase_path("resources/welcome_icons/sparkles.svg", root_build_dir),
    "kKoanWelcomeIconX=" +
