# chrome://koan-settings. Linked through //chrome/browser/ui/webui:configs,
# which registers it.
source_set("webui") {
  sources = [
    "koan_settings_handler.cc",
    "koan_settings_handler.h",
    "koan_settings_rows.cc",
    "koan_settings_rows.h",
    "koan_settings_ui.cc",
    "koan_settings_ui.h",
    "koan_welcome_handler.cc",
    "koan_welcome_handler.h",
    "koan_welcome_host.cc",
    "koan_welcome_host.h",
    "koan_welcome_ui.cc",
    "koan_welcome_ui.h",
  ]
  public_deps = [
    "//content/public/browser",
    "//ui/views",
  ]
  deps = [
    ":resources",
    ":welcome_resources",
    "//base",
    "//chrome/browser:shell_integration",
    "//chrome/browser/importer",
    "//chrome/browser/search_engines",
    "//chrome/browser/themes",
    "//components/search_engines",
    "//components/user_data_importer/common",
    "//services/network/public/mojom",
    "//url",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:accelerator_table",
    "//components/performance_manager",
    "//components/prefs",
    "//content/public/common",
    "//koan/browser:features",
    "//koan/browser:prefs",
    "//koan/browser:shortcut_table",
    "//koan/browser/ui/color:tokens",
    "//koan/browser/ui/fonts",
    "//koan/common:url_constants",
    "//ui/base",
    "//ui/events:event_constants",
  ]
}

# The page's files as C++ strings (koan_settings_resources.h).
action("resources") {
  script = "embed_resources.py"
  sources = [
    "resources/koan_settings.css",
    "resources/koan_settings.html",
    "resources/koan_settings.js",
  ]
  outputs = [ "$target_gen_dir/koan_settings_resources.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    "kKoanSettingsHtml=" +
        rebase_path("resources/koan_settings.html", root_build_dir),
    "kKoanSettingsCss=" +
        rebase_path("resources/koan_settings.css", root_build_dir),
    "kKoanSettingsJs=" +
        rebase_path("resources/koan_settings.js", root_build_dir),
  ]
}

# chrome://koan-welcome's files as C++ strings (koan_welcome_resources.h):
# the page (Zen's welcome, MPL-2.0) and Zen's Essentials favicons.
action("welcome_resources") {
  script = "embed_resources.py"
  sources = [
    "resources/koan_welcome.css",
    "resources/koan_welcome.html",
    "resources/koan_welcome.js",
    "resources/welcome_back.svg",
    "resources/welcome_favicons/calendar.svg",
    "resources/welcome_favicons/discord.svg",
    "resources/welcome_favicons/figma.svg",
    "resources/welcome_favicons/github.svg",
    "resources/welcome_favicons/notion.svg",
    "resources/welcome_favicons/obsidian.svg",
    "resources/welcome_favicons/slack.svg",
    "resources/welcome_favicons/trello.svg",
    "resources/welcome_favicons/tuta.svg",
  ]
  outputs = [ "$target_gen_dir/koan_welcome_resources.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    "kKoanWelcomeHtml=" +
        rebase_path("resources/koan_welcome.html", root_build_dir),
    "kKoanWelcomeCss=" +
        rebase_path("resources/koan_welcome.css", root_build_dir),
    "kKoanWelcomeJs=" +
        rebase_path("resources/koan_welcome.js", root_build_dir),
    "kKoanWelcomeBackSvg=" +
        rebase_path("resources/welcome_back.svg", root_build_dir),
    "kKoanWelcomeFaviconCalendar=" +
        rebase_path("resources/welcome_favicons/calendar.svg", root_build_dir),
    "kKoanWelcomeFaviconDiscord=" +
        rebase_path("resources/welcome_favicons/discord.svg", root_build_dir),
    "kKoanWelcomeFaviconFigma=" +
        rebase_path("resources/welcome_favicons/figma.svg", root_build_dir),
    "kKoanWelcomeFaviconGithub=" +
        rebase_path("resources/welcome_favicons/github.svg", root_build_dir),
    "kKoanWelcomeFaviconNotion=" +
        rebase_path("resources/welcome_favicons/notion.svg", root_build_dir),
    "kKoanWelcomeFaviconObsidian=" +
        rebase_path("resources/welcome_favicons/obsidian.svg", root_build_dir),
    "kKoanWelcomeFaviconSlack=" +
        rebase_path("resources/welcome_favicons/slack.svg", root_build_dir),
    "kKoanWelcomeFaviconTrello=" +
        rebase_path("resources/welcome_favicons/trello.svg", root_build_dir),
    "kKoanWelcomeFaviconTuta=" +
        rebase_path("resources/welcome_favicons/tuta.svg", root_build_dir),
  ]
}
