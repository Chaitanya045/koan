import("//build/buildflag_header.gni")

declare_args() {
  # Test only: the update check also takes --koan-update-manifest-url and
  # --koan-update-public-key (koan_update_source.h), to try it against a local
  # manifest signed with a throwaway key. Never set in build/*.gn: CI turns
  # it on only for a run that is neither a release nor kept as a base for the
  # nightlies (KOAN_UPDATE_TEST_HOOKS, scripts/build.sh), so nothing that is
  # published has it. scripts/tests/test_update_test_hooks.py checks that.
  koan_update_test_hooks = false
}

assert(!koan_update_test_hooks || !is_official_build,
       "koan_update_test_hooks is for test builds, never an official one")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [ "KOAN_UPDATE_TEST_HOOKS=$koan_update_test_hooks" ]
}

# The release signing key's public half, built in from the text file
# (public_key_header.py checks it is one Ed25519 key).
action("public_key_header") {
  script = "public_key_header.py"
  inputs = [ "koan_update_public_key.txt" ]
  outputs = [ "$target_gen_dir/koan_update_public_key.h" ]
  args = [
    "--input",
    rebase_path(inputs[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

# The manifest's SemVer, parsing, signature and URL checks, and when to tell
# (pure, unit-tested in //koan/test:koan_unittests).
source_set("update_logic") {
  sources = [
    "koan_update_logic.cc",
    "koan_update_logic.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [ "//third_party/boringssl" ]
}

# Where the manifest comes from and the key it is checked against. Only this
# file sees the key and the test hooks flag.
source_set("update_source") {
  sources = [
    "koan_update_source.cc",
    "koan_update_source.h",
  ]
  public_deps = [
    ":update_logic",
    "//url",
  ]
  deps = [
    ":buildflags",
    ":install_logic",
    ":public_key_header",
    "//base",
  ]
}

# What Koan decides when it installs an update itself (the Mac, #550): the
# download, staging and rollback state, the fallbacks and the install marker
# (pure, unit-tested in //koan/test:koan_unittests).
source_set("install_logic") {
  sources = [
    "koan_update_install_logic.cc",
    "koan_update_install_logic.h",
  ]
  public_deps = [
    ":update_logic",
    "//base",
  ]
}

# The mechanics behind koan_update_platform.h: the Mac's hdiutil, ditto,
# codesign, quarantine removal and the helper's start. Elsewhere there are
# none (CreateInstallPlatform() returns null).
source_set("install_platform") {
  sources = [
    "koan_update_platform.cc",
    "koan_update_platform.h",
  ]
  public_deps = [
    ":install_logic",
    "//base",
  ]
  if (is_mac) {
    sources += [ "koan_update_platform_mac.mm" ]
    deps = [ ":update_source" ]
    frameworks = [ "Foundation.framework" ]
  }
}

if (is_mac) {
  # Swaps a staged update in once Koan has exited, and rolls it back
  # (koan_update_helper_main.mm). In Koan.app/Contents/Resources/bin, with
  # the agent's tools (//koan/cli:koan_bundle_data), and signed with the app.
  executable("koan-update-helper") {
    sources = [ "koan_update_helper_main.mm" ]
    deps = [
      ":install_logic",
      ":install_platform",
      ":update_source",
      "//base",
    ]
    frameworks = [
      "AppKit.framework",
      "Foundation.framework",
    ]
  }
}
